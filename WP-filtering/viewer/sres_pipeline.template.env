# Copy this file, fill in your dataset-specific paths, then run:
#   ./run_sres_viewer.sh --config /path/to/your_dataset.env

INTEGRATE_HKL=/absolute/path/to/INTEGRATE.HKL
RAW_HKL=/absolute/path/to/shelx.hkl
FCF=/absolute/path/to/shelx.fcf
IMAGE_SRC=/absolute/path/to/frame_images

# Optional
OUT_DIR=/absolute/path/to/output_dir
IMAGE_SIZE=256
PORT=8051
MIN_SIGMA=1e-12

# Optional Conda env overrides
VIEWER_ENV=dfmviewer
CCTBX_ENV=cctbx-env
